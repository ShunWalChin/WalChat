{
  "name": "wal-chat",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3001",
    "dev:app": "vite dev --host 0.0.0.0 --port 3001",
    "dev:all": "concurrently -k -n app,webhooks,scheduler -c green,blue,yellow \"npm:dev:app\" \"npm:worker:webhooks\" \"npm:worker:scheduler\"",
    "local:up": "supabase start && docker compose up -d redis",
    "local:status": "supabase status && docker compose ps",
    "local:down": "docker compose stop redis && supabase stop",
    "worker:webhooks": "tsx --env-file=.env.local src/workers/instagram.worker.ts",
    "worker:scheduler": "tsx --env-file=.env.local src/workers/scheduler.worker.ts",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "node scripts/server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "smoke:integrations": "node --env-file=.env.local scripts/smoke-integrations.mjs",
    "validate:routes": "node scripts/validate-routes.mjs",
    "audit:system": "node scripts/audit-system.mjs",
    "prod:up": "docker compose --env-file .env.production -f docker-compose.production.yml up -d --build",
    "prod:down": "docker compose --env-file .env.production -f docker-compose.production.yml down",
    "prod:logs": "docker compose --env-file .env.production -f docker-compose.production.yml logs -f --tail=200"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.20",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "ai": "^7.0.33",
    "bullmq": "^5.80.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "ioredis": "^5.11.1",
    "lucide-react": "^0.545.0",
    "openai": "6.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.8.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "supabase": "^2.109.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
