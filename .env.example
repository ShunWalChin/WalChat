# Supabase/Lovable Cloud — somente estes dois valores públicos recebem VITE_.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=cole_a_publishable_key_do_supabase_status
VITE_PUBLIC_SITE_URL=http://localhost:3001
VITE_PUBLIC_SUPPORT_EMAIL=privacidade@seu-dominio.com.br
VITE_PUBLIC_RESPONSE_SLA=Resposta humana em até 1 dia útil.
# GA4 só carrega após consentimento explícito no banner.
VITE_GA_MEASUREMENT_ID=
# Só configure dados reais e publicáveis. O schema LocalBusiness depende deles.
VITE_PUBLIC_BUSINESS_ADDRESS=
VITE_PUBLIC_BUSINESS_HOURS=Mo-Fr 09:00-18:00
VITE_PUBLIC_GOOGLE_MAPS_URL=
VITE_PUBLIC_GOOGLE_MAPS_EMBED_URL=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=cole_a_secret_key_do_supabase_status
SUPABASE_PUBLISHABLE_KEY=cole_a_mesma_publishable_key_sem_prefixo_vite

# Redis/BullMQ local
REDIS_URL=redis://127.0.0.1:6380

# Meta — NUNCA use prefixo VITE_ nestes secrets.
META_APP_ID=
META_APP_SECRET=local-meta-secret-change-me
META_ACCESS_TOKEN=
META_PUBLISH_TOKEN=
META_VERIFY_TOKEN=wal-chat-local-verify-token
META_GRAPH_VERSION=v25.0
# ID da configuração publicada de Embedded Signup no Facebook Login for Business.
META_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Deve ser idêntica à URI cadastrada no painel da Meta.
META_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/meta/callback

# Google Workspace — OAuth web app para Calendar, Meet e Tasks.
# Cadastre a redirect URI exatamente como abaixo no Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# IA. OpenAI usa a Responses API; Gemini permanece como provedor opcional.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_PROJECT=
OPENAI_ORGANIZATION=
GOOGLE_GENERATIVE_AI_API_KEY=

# n8n gerenciado opcional. Cada workspace pode substituir estes valores pelo wizard.
# API key e segredo HMAC nunca recebem prefixo VITE_.
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SIGNING_SECRET=
# Hosts internos só são permitidos quando listados explicitamente pelo operador.
N8N_ALLOWED_HOSTS=

# Gere com: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=

APP_ORIGIN=http://localhost:3001
DEMO_MODE=true
